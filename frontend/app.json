{
  "expo": {
    "name": "Bugasan ni Ali",
    "slug": "bugasan-ni-ali",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uk.ccshub.perlas.bugasanniali",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "uk.ccshub.perlas.bugasanniali",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#E3F1E9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Bugasan ni Ali",
      "themeColor": "#1E6B47"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#1E6B47",
          "defaultChannel": "orders"
        }
      ],
      "expo-background-task"
    ],
    "scheme": "bugasanniali",
    "notification": {
      "icon": "./assets/android-icon-monochrome.png",
      "color": "#1E6B47",
      "androidMode": "default",
      "androidCollapsedTitle": "Bugasan ni Ali"
    }
  }
}
