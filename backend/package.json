{
  "name": "bugasan-ni-ali-api",
  "version": "1.0.0",
  "description": "Backend API for Bugasan ni Ali — rice ordering, retail/wholesale sales and inventory",
  "type": "module",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "seed": "node --env-file-if-exists=.env src/db/seed.js",
    "set-password": "node --env-file-if-exists=.env src/db/setPassword.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  }
}
