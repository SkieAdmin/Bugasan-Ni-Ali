# Copy to .env and fill in.  cp .env.example .env

NODE_ENV=production

# Port and address of the API. Behind nginx keep 127.0.0.1 so only nginx can reach it.
# For testing with Expo Go on a phone (no nginx), use HOST=0.0.0.0.
PORT=3000
HOST=127.0.0.1

# Secret for signing login tokens. REQUIRED in production. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login lasts on a phone.
JWT_EXPIRES_IN=30d

# SQLite database file (relative to the backend folder).
DB_PATH=data/bugasan.db

# Time zone used to group sales by day in the reports.
TZ=Asia/Manila

# Allowed browser origins (only matters for the Expo web build). * = any.
CORS_ORIGINS=*

# Which proxies to trust for the visitor IP. "loopback" = nginx on the same server.
TRUST_PROXY=loopback
